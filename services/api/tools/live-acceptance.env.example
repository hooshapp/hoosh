# Copy to services/api/.local/live-acceptance.env on a NEW checkout; chmod 600.
# Use two approved disposable development accounts. Never commit filled values.
# Existing checkout: preserve the private file rather than overwriting tokens.
API_ACCEPTANCE_ACCESS_TOKEN_A=
API_ACCEPTANCE_ACCESS_TOKEN_B=
# Existing development project publishable key; not an admin/secret/service key.
API_ACCEPTANCE_PUBLISHABLE_KEY=
