# Development with all four SUPABASE settings absent is a liveness-only local shell.
# Production startup and every configured environment require all four together.
APP_ENV=development
CORS_ALLOWED_ORIGINS=["http://localhost:8081","http://127.0.0.1:8081"]
# Get observed public trust metadata from Anisha's SB-02 handoff; no defaults guessed.
# SUPABASE_PROJECT_URL=https://<development-project>.supabase.co
# SUPABASE_JWT_ISSUER=https://<development-project>.supabase.co/auth/v1
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWT_ALGORITHMS=["<observed-ES256-or-RS256>"]
# Optional bounded tuning defaults (seconds unless noted):
# AUTH_TOKEN_MAX_BYTES=16384
# AUTH_CLOCK_SKEW_SECONDS=30
# AUTH_JWKS_TTL_SECONDS=300
# AUTH_JWKS_BUDGET_SECONDS=5
# AUTH_JWKS_CONNECT_SECONDS=2
# AUTH_JWKS_MAX_BYTES=262144
# AUTH_JWKS_MAX_KEYS=16
# AUTH_JWKS_REFRESH_COOLDOWN_SECONDS=30
# AUTH_JWKS_NEGATIVE_TTL_SECONDS=60
# AUTH_JWKS_NEGATIVE_MAX_ENTRIES=64
# M2 only; never use migration credentials as runtime fallback:
# DATABASE_URL=
# MIGRATION_DATABASE_URL=
