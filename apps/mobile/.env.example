# Set only public mobile configuration here; never include service/database keys.
# Optional for the UI shell. Physical phones need your computer's LAN IP or a
# reachable HTTPS development API; localhost refers to the phone itself.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Required for real account actions; missing settings never enable private routes.
# Copy only a development publishable key, never a secret/service/database key.
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public switches: keep false until each provider is configured and tested.
# Client secrets, Apple signing keys and SMTP credentials belong in dashboards.
EXPO_PUBLIC_APPLE_NATIVE_ENABLED=false
EXPO_PUBLIC_APPLE_OAUTH_ENABLED=false
EXPO_PUBLIC_GOOGLE_ENABLED=false
