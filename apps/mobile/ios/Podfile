ENV['RNS_GAMMA_ENABLED'] ||= '1'
ENV['RCT_USE_RN_DEP'] ||= '1'
ENV['RCT_USE_PREBUILT_RNCORE'] ||= '1'
ENV['EXPO_USE_PRECOMPILED_MODULES'] ||= '1'

require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), 'scripts/autolinking')
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), 'scripts/react_native_pods')

platform :ios, '16.4'
project 'DisconnectApp.xcodeproj'
prepare_react_native_project!

target 'DisconnectApp' do
  use_expo_modules!
  config = use_native_modules!([
    'node', '--no-warnings', '--eval', "require('expo/bin/autolinking')",
    'expo-modules-autolinking', 'react-native-config', '--json', '--platform', 'ios'
  ])
  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    :app_path => File.expand_path('..', __dir__),
    :privacy_file_aggregation_enabled => true
  )
  post_install do |installer|
    react_native_post_install(installer, config[:reactNativePath], :mac_catalyst_enabled => false)
  end
end
