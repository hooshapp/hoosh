    "@expo/ui": "~58.0.25",
    "@tanstack/react-query": "^5.105.0",
    "expo": "~58.0.21",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-font": "~58.0.11",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.28",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "test-renderer": "1.3.0",
    "typescript": "~6.0.3",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src dev/ui jest.setup.ts jest.config.cjs",
    "test": "npm run test:unit && npm run test:components",
    "test:unit": "vitest run",
    "test:components": "jest --runInBand",
    "ui:preview": "vite --config dev/vite.config.mts",
    "ui:build": "vite build --config dev/vite.config.mts"
